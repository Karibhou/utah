[Unit]
Description=Record booted bootc image ref for unprivileged consumers
Documentation=https://github.com/projectbluefin/utah/issues/675
ConditionPathExists=/usr/bin/bootc
After=local-fs.target
Before=systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/rm -f /run/ublue-booted-image.json
ExecStart=-/usr/bin/bootc status --json
StandardOutput=append:/run/ublue-booted-image.json
ExecStartPost=/usr/bin/ublue-booted-image-sync

[Install]
WantedBy=multi-user.target
